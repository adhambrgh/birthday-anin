# Database URL untuk AI (READ-ONLY credentials!)
# Format: protocol://user:password@host:port/database

# PostgreSQL
AI_DATABASE_URL=postgresql://ai_agent:password@localhost:5432/your_db?sslmode=require

# SQLite
# AI_DATABASE_URL=sqlite:///path/to/db.sqlite?mode=ro

# MySQL
# AI_DATABASE_URL=mysql://ai_agent:password@localhost:3306/your_db

# MongoDB
# AI_DATABASE_URL=mongodb://ai_agent:password@localhost:27017/your_db

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
